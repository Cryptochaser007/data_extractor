# ── Copy this file to .env and fill in your values ──

# WordPress
WP_BASE_URL=https://yoursite.com
WP_USERNAME=your_wp_username
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx   # WP Admin → Users → Application Passwords

# Post type: "job_listing" (WP Job Manager) or "post" (standard)
WP_POST_TYPE=job_listing

# "publish" to go live immediately, "pending" for manual review queue
WP_POST_STATUS=publish

# Category slug auto-assigned to every post
WP_CATEGORY=government-jobs

# data.gov.in free API key (register at https://data.gov.in)
DATAGOVIN_API_KEY=your_key_here

# SQLite database path
DB_PATH=govjobs.db

# Enable/disable individual sources (true/false)
ENABLE_UPSC=true
ENABLE_SSC=true
ENABLE_EMPLOYMENT_NEWS=true
ENABLE_DATAGOVIN=true
ENABLE_NCS=true
ENABLE_RAILWAYS=true

# Crawl behaviour
REQUEST_TIMEOUT=15
DEFAULT_DELAY=2.0
